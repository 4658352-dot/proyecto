        </ul>
    </div>

    <!-- Galería con Tarjetas de Volteo (Flip Cards) -->
    <div class="galeria-fotos">
        <div class="tarjeta-flip">
            <div class="tarjeta-flip-inner">
                <div class="tarjeta-flip-front">
                    <img src="https://queleerlibros.com/wp-content/uploads/2018/02/el-extranjero-201x300.jpg" alt="El extranjero">
                </div>
                <div class="tarjeta-flip-back">
                    El extranjero (1942)
                </div>
            </div>
        </div>

        <div class="tarjeta-flip">
            <div class="tarjeta-flip-inner">
                <div class="tarjeta-flip-front">
                    <img src="https://queleerlibros.com/wp-content/uploads/2018/02/la-peste-205x300.jpg" alt="La peste">
                </div>
